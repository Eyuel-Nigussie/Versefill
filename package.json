{
  "name": "Versefill",
  "displayName": "Versefill",
  "description": "Generate meaningful, non-repetitive Bible-based placeholder text just like Lorem Ipsum by writing the versefill keyword!",
  "version": "1.0.0",
  "icon": "versefill.png", 
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Snippets"
  ],
  "activationEvents": [
    "*",
    "onCommand:versefill.manual"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "versefill.manual",
        "title": "VerseFill: Generate Bible-based Placeholder Text"
      }
    ],
    "keybindings": [
      {
        "command": "versefill.manual",
        "key": "ctrl+alt+v",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "VerseFill",
      "properties": {
        "versefill.includeReferences": {
          "type": "boolean",
          "default": false,
          "description": "Include Bible verse references in the generated text"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "clean": "rimraf dist out build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {},
  "publisher": "EyuelNigussie",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyuel-nigussie/Versefill.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/eyuel-nigussie/Versefill",
  "bugs": {
    "url": "https://github.com/eyuel-nigussie/Versefill/issues"
  }
}
